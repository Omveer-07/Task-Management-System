@model List<TaskManagementSystem.Models.Project>

<h1>Projects</h1>

<p>
    <a href="/Project/Create">Add Project</a>
</p>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
        <th>Department</th>
    </tr>

    @foreach (var project in Model)
    {
        <tr>
            <td>@project.Id</td>
            <td>@project.Name</td>
            <td>@project.Description</td>
            <td>@project.Department?.Name</td>
        </tr>
    }
</table>