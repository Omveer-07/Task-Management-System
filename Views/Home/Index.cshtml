@model TaskManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Task Management Dashboard</h1>

<hr />

<div>
    <h3>Total Departments: @Model.TotalDepartments</h3>
</div>

<div>
    <h3>Total Projects: @Model.TotalProjects</h3>
</div>

<div>
    <h3>Total Tasks: @Model.TotalTasks</h3>
</div>

<div>
    <h3>Pending Tasks: @Model.PendingTasks</h3>
</div>

<div>
    <h3>Completed Tasks: @Model.CompletedTasks</h3>
</div>