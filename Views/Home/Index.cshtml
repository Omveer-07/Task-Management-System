@{
    ViewData["Title"] = "Dashboard";
}

@if (User.IsInRole("Admin"))
{
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Projects</h6>
                            <h2>@ViewBag.TotalProjects</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Employees</h6>
                            <h2>@ViewBag.TotalEmployees</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Tasks</h6>
                            <h2>@ViewBag.TotalTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Pending</h6>
                            <h2>@ViewBag.PendingTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">In Progress</h6>
                            <h2>@ViewBag.ProgressTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Completed</h6>
                            <h2>@ViewBag.CompletedTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

    </div>
}
else
{
    <h2 class="mb-4">Employee Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">My Tasks</h6>
                            <h2>@ViewBag.MyTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Pending</h6>
                            <h2>@ViewBag.MyPending</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Progress</h6>
                            <h2>@ViewBag.MyProgress</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Completed</h6>
                            <h2>@ViewBag.MyCompleted</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Due</h6>
                            <h2>@ViewBag.Upcoming</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

    </div>
}

<hr class="my-5" />

<h3 class="mb-3">Recent Tasks</h3>

@if (((IEnumerable<TaskManagementSystem.Models.TaskItem>)ViewBag.RecentTasks).Any())
{
    <table class="table table-striped table-hover">

        @if (User.IsInRole("Admin"))
        {
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Project</th>
                    <th>Employee</th>
                    <th>Status</th>
                    <th>Due Date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var task in ViewBag.RecentTasks)
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@task.Project?.Name</td>
                        <td>@task.Employee?.Name</td>
                        <td>@task.Status</td>
                        <td>@task.DueDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Due Date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var task in ViewBag.RecentTasks)
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>@task.Project?.Name</td>
                        <td>@task.Status</td>
                        <td>@task.DueDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        }

    </table>
}
else
{
    <div class="alert alert-info">
        No recent tasks found.
    </div>
}