@{
    ViewData["Title"] = "Dashboard";
}

@if (User.IsInRole("Admin"))
{
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Projects</h6>
                            <h2>@ViewBag.TotalProjects</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Employees</h6>
                            <h2>@ViewBag.TotalEmployees</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Tasks</h6>
                            <h2>@ViewBag.TotalTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Pending</h6>
                            <h2>@ViewBag.TotalPendingTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">In Progress</h6>
                            <h2>@ViewBag.TotalProgressTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Completed</h6>
                            <h2>@ViewBag.TotalCompletedTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

    </div>
}
else
{
    <h2 class="mb-4">Employee Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">My Tasks</h6>
                            <h2>@ViewBag.MyTasks</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Pending</h6>
                            <h2>@ViewBag.MyPending</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Progress</h6>
                            <h2>@ViewBag.Myprogress</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Completed</h6>
                            <h2>@ViewBag.Mycompleted</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white shadow-lg border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-uppercase">Due</h6>
                            <h2>@ViewBag.Upcoming</h2>
                        </div>

                        <i class="bi bi-folder-fill display-3"></i>

                    </div>
                </div>
            </div>
        </div>

    </div>
}