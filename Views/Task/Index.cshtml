@model List<TaskManagementSystem.Models.TaskItem>

<h1>Tasks</h1>

<p>
    <a href="/Task/Create">Add Task</a>
</p>

<table border="1">

    <tr>
        <th>Title</th>
        <th>Status</th>
        <th>Due Date</th>
        <th>Project</th>
        <th>Actions</th>
    </tr>

    @foreach (var task in Model)
    {
        <tr>
            <td>@task.Title</td>
            <td>@task.Status</td>
            <td>@task.DueDate.ToShortDateString()</td>
            <td>@task.Project?.Name</td>
            <td>
                <a href="/Task/Edit/@task.Id">Edit</a> |
                <a href="/Task/Delete/@task.Id">Delete</a>
            </td>
        </tr>
    }

</table>