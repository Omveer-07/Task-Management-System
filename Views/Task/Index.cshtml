@model List<TaskManagementSystem.Models.TaskItem>

@if (User.IsInRole("Admin"))
{
    <h2 class="mb-3">Task Management</h2>
}
else
{
    <h2 class="mb-3">My Tasks</h2>
}

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            + Add Task
        </a>
    </p>
}

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Project</th>
            <th>Assigned To</th>
            <th width="180">Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var task in Model)
        {
            <tr>

                <td>@task.Title</td>

                <td>
                    @if (task.Priority == "High")
                    {
                        <span class="badge bg-danger">High</span>
                    }
                    else if (task.Priority == "Medium")
                    {
                        <span class="badge bg-warning text-dark">Medium</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Low</span>
                    }
                </td>

                <td>@task.Status</td>

                <td>@task.DueDate.ToShortDateString()</td>

                <td>@task.Project?.Name</td>

                <td>@task.Employee?.Name</td>

                <td>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-danger btn-sm"
                           onclick="return confirm('Delete this task?')">
                            Delete
                        </a>
                    }
                    else
                    {
                        <a asp-action="UpdateStatus" asp-route-id="@task.Id" class="btn btn-primary btn-sm">
                            Update Status
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>